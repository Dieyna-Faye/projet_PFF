# Exemple de configuration pour le backend
# Copie ce fichier en .env puis mets tes valeurs.

NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-in-production-32-chars
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

DB_DIALECT=sqlite
DB_STORAGE=./data/marches.db

# Optionnel si tu utilises PostgreSQL/MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marches_publics
DB_USER=root
DB_PASSWORD=MotDePasseMysql
DB_SSL=false

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

