# API Express + base SQLite locale (configuration par défaut)
PORT=4000
DB_DIALECT=sqlite
DB_STORAGE=./data/marches.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Fichiers déposés (ne pas exposer ce dossier comme contenu statique)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# URL privée du service IA local
AI_SERVICE_URL=http://127.0.0.1:5000
AI_SERVICE_API_KEY=

# Origines du frontend autorisées
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

