# Exemple de configuration MySQL pour ce projet
# Copie ce fichier en .env puis mets tes valeurs.

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=marches_publics
DB_USER=root
DB_PASSWORD=MotDePasseMysql

# Optionnel : true/false (utile selon le cas)
DB_SSL=false

# Stockage upload (inchangé)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Service IA Python (Microservice FastAPI)
AI_SERVICE_URL=http://localhost:5000

